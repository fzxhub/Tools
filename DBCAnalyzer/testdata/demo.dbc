CM_ BO_ 256 "Vehicle speed and odometer, 20ms cycle";
CM_ SG_ 256 Speed "Scaled speed signal";
CM_ SG_ 257 CoolantTemp "Signed temperature with -40 offset";
CM_ SG_ 2566844672 BatteryVoltage "Motorola 16-bit big-endian signal";
CM_ SG_ 768 Selector "Multiplexor: 0=Voltage, 1=Count";

CM_ BO_ 1280 "CAN FD 64-byte frame with 60 signals, 100ms cycle";
VAL_ 256 Gear 0 "P" 1 "R" 2 "N" 3 "D" ;
VAL_ 2566844672 BMSState 0 "Standby" 1 "Charging" 2 "Discharging" 3 "Fault" ;
